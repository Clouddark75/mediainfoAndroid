<?xml version="1.0" encoding="utf-8"?>
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    
    <!-- Thin -->
    <font
        android:fontStyle="normal"
        android:fontWeight="100"
        android:font="@font/googlesans_flex_thin"
        app:fontStyle="normal"
        app:fontWeight="100"
        app:font="@font/googlesans_flex_thin" />
    
    <!-- Light -->
    <font
        android:fontStyle="normal"
        android:fontWeight="300"
        android:font="@font/googlesans_flex_light"
        app:fontStyle="normal"
        app:fontWeight="300"
        app:font="@font/googlesans_flex_light" />
    
    <!-- Regular -->
    <font
        android:fontStyle="normal"
        android:fontWeight="400"
        android:font="@font/googlesans_flex_regular"
        app:fontStyle="normal"
        app:fontWeight="400"
        app:font="@font/googlesans_flex_regular" />
    
    <!-- Medium -->
    <font
        android:fontStyle="normal"
        android:fontWeight="500"
        android:font="@font/googlesans_flex_medium"
        app:fontStyle="normal"
        app:fontWeight="500"
        app:font="@font/googlesans_flex_medium" />
    
    <!-- Bold -->
    <font
        android:fontStyle="normal"
        android:fontWeight="700"
        android:font="@font/googlesans_flex_bold"
        app:fontStyle="normal"
        app:fontWeight="700"
        app:font="@font/googlesans_flex_bold" />
    
    <!-- ExtraBold -->
    <font
        android:fontStyle="normal"
        android:fontWeight="800"
        android:font="@font/googlesans_flex_extrabold"
        app:fontStyle="normal"
        app:fontWeight="800"
        app:font="@font/googlesans_flex_extrabold" />
</font-family>
