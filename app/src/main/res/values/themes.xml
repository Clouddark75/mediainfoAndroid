<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base Material3 Expressive -->
    <style name="Theme.MediaInfo.Base"
        parent="Theme.Material3.DynamicColors.DayNight.NoActionBar">

        <!-- Tipografía -->
        <item name="android:fontFamily">@font/google_sans_font_family</item>
        <item name="fontFamily">@font/google_sans_font_family</item>

        <!-- System bars -->
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>

        <!-- Window background (Material3 CORRECTO) -->
        <item name="android:windowBackground">
            ?attr/colorSurfaceContainerLowest
        </item>

        <!-- Expressive shapes -->
        <item name="shapeAppearanceCornerExtraLarge">@dimen/shape_extra_large</item>
        <item name="shapeAppearanceCornerLarge">@dimen/shape_large</item>
        <item name="shapeAppearanceCornerMedium">@dimen/shape_medium</item>
        <item name="shapeAppearanceCornerSmall">@dimen/shape_small</item>

        <!-- Window -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

    </style>

    <!-- Theme activo -->
    <style name="Theme.MediaInfo" parent="Theme.MediaInfo.Base"/>

</resources>
